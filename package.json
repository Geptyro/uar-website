{
	"name": "website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"release": "node scripts/release.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"players:extract": "node scripts/extract-players.ts",
		"players:import": "node scripts/import-replays.ts",
		"feedback:list": "node --env-file=.env scripts/list-feedback.ts",
		"test": "node --test \"tests/**/*.test.ts\"",
		"test:integration": "bash tests/integration/run.sh",
		"link:shared": "npm i ../shared --no-save",
		"unlink:shared": "npm i"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@google/model-viewer": "^4.3.1",
		"aws4fetch": "^1.0.20",
		"grid-router": "github:Geptyro/grid-router",
		"mongodb": "^7.5.0",
		"seek-bzip": "^2.0.0",
		"uar-shared": "git+https://github.com/Geptyro/uar-shared.git#semver:^0.1.0"
	}
}
