# Static server for the prerendered build. This SITE owns its cache policy —
# the gateway stays path-agnostic (same split as gw1-bestiary's server.js).
{
	auto_https off
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	# SvelteKit adapter-static writes /units as units.html etc.
	try_files {path} {path}.html {path}/index.html

	# Hashed build assets never change — cache forever.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	file_server
}
